# --- Substack credentials (required for fully automated sync) ---
# Your Substack login email and password
# Note: You must set a password on Substack (Settings > Account > Set password)
SUBSTACK_EMAIL=you@example.com
SUBSTACK_PASSWORD=your_substack_password
# Your Substack subdomain, e.g. "matt" for matt.substack.com
SUBSTACK_PUBLICATION=your_substack_name

# --- Beehiiv API credentials ---
# Get your API key from: https://app.beehiiv.com/settings/integrations
# Your publication ID looks like: pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BEEHIIV_API_KEY=your_api_key_here
BEEHIIV_PUBLICATION_ID=pub_your_publication_id_here

# Optional: delay between API calls in milliseconds (default: 300)
# Increase if you hit rate limits
SYNC_DELAY_MS=300
