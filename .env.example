# --- IMAP credentials (required for fully automated sync) ---
# Your email IMAP settings — this is where Substack sends "new subscriber" notifications
# For Gmail: host=imap.gmail.com, port=993, use an App Password (not your regular password)
# For Outlook: host=outlook.office365.com, port=993
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
IMAP_PASS=your_app_password_here
# Optional: monitor a specific mailbox/label instead of INBOX
# IMAP_MAILBOX=INBOX

# --- Beehiiv API credentials ---
# Get your API key from: https://app.beehiiv.com/settings/integrations
# Your publication ID looks like: pub_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BEEHIIV_API_KEY=your_api_key_here
BEEHIIV_PUBLICATION_ID=pub_your_publication_id_here

# Optional: delay between API calls in milliseconds (default: 300)
# Increase if you hit rate limits
SYNC_DELAY_MS=300
